# Runtime
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
# Runtime candidate serving is live-only. If no verified live observations exist,
# the API returns an honest empty state; it never substitutes fixture candidates.
DATASET_MODE=live
INGESTION_ENABLED=false
INGESTION_ACTIVATION_ID=
INGESTION_SOURCE_ID=travis_tcad_parcels
# Reserved profile/audit reference; the v1 runtime uses a compiled descriptor and env allowlist.
INGESTION_CONFIG_PATH=config/ingestion/us-tx-central-texas-v1.yaml
INGESTION_PAGE_SIZE=250
INGESTION_MAX_RECORDS=250
INGESTION_WHERE=PROP_ID IS NOT NULL AND tcad_acres >= 1
INGESTION_ORDER_BY=OBJECTID ASC
INGESTION_CITIES=
INGESTION_HTTP_TIMEOUT_SECONDS=30
INGESTION_MIN_REQUEST_INTERVAL_SECONDS=1
INGESTION_MAX_RETRIES=3
RAW_ARTIFACT_ROOT=./var/raw-artifacts
LIVE_SOURCE_DISPLAY_ENABLED=false
LIVE_SOURCE_DISPLAY_APPROVAL_ID=
ALERT_DELIVERY_MODE=log
PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000

# Persistence
DATABASE_URL=postgresql+psycopg://seekandscore:seekandscore@localhost:5432/seekandscore
REDIS_URL=redis://localhost:6379/0

# Immutable object storage
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=seekandscore-raw-dev
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Railway's current buckets use virtual-hosted style; legacy/local providers may differ.
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_PREFIX=raw-artifacts

# Maps and geocoding (provider selected in Phase 0)
NEXT_PUBLIC_MAP_STYLE_URL=
GEOCODER_PROVIDER=
GEOCODER_API_KEY=

# Authentication (provider selected in Phase 0)
AUTH_SECRET=
AUTH_ISSUER=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

# Optional AI analyst layer; disabled by default
AI_ANALYST_ENABLED=false
OPENAI_API_KEY=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# Acquisition engagement; every environment and channel defaults off.
# Production activation additionally requires a reviewed policy record, source
# rights, party/contact verification, fresh preflight, approval, and suppression.
OUTREACH_SEND_ENABLED=false
OUTREACH_MODE=disabled
OUTREACH_POLICY_ID=acquisition-outreach-safe-default-v1
OUTREACH_HUMAN_APPROVAL_REQUIRED=true
OUTREACH_EMAIL_ENABLED=false
OUTREACH_EMAIL_PROVIDER=
OUTREACH_SENDER_EMAIL=
OUTREACH_SENDER_NAME=
OUTREACH_SENDER_POSTAL_ADDRESS=
OUTREACH_WEBHOOK_SECRET=
OUTREACH_CALENDAR_ENABLED=false
OUTREACH_CALENDAR_PROVIDER=ics
OUTREACH_SECURE_UPLOAD_ENABLED=false
OUTREACH_SECURE_UPLOAD_PROVIDER=
CONTACT_VALUE_ENCRYPTION_KEY=
CONTACT_LOOKUP_HMAC_KEY=

# Source credentials belong in a secret manager/Railway variables. Add one
# namespaced block per enabled adapter; never commit real credentials.
