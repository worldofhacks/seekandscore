# Runtime
APP_ENV=development
LOG_LEVEL=INFO
PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000

# Persistence
DATABASE_URL=postgresql+psycopg://seekandscore:seekandscore@localhost:5432/seekandscore
REDIS_URL=redis://localhost:6379/0

# Immutable object storage
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=seekandscore-raw-dev
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Maps and geocoding (provider selected in Phase 0)
NEXT_PUBLIC_MAP_STYLE_URL=
GEOCODER_PROVIDER=
GEOCODER_API_KEY=

# Authentication (provider selected in Phase 0)
AUTH_SECRET=
AUTH_ISSUER=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

# Optional AI analyst layer; disabled by default
AI_ANALYST_ENABLED=false
OPENAI_API_KEY=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# Source credentials belong in a secret manager/Railway variables. Add one
# namespaced block per enabled adapter; never commit real credentials.
